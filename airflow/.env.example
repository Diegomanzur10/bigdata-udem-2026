# Plantilla de variables para airflow/docker-compose.yaml.
# En la VM, user-data genera /opt/airflow/.env con valores aleatorios; no commitear el .env real.
# Local: cp airflow/.env.example airflow/.env y reemplazar los valores.

# UID del usuario de los contenedores (imagen oficial usa 50000).
AIRFLOW_UID=50000

# Región para la conexión aws_default (rol de instancia).
AWS_REGION=us-east-2

# Postgres de Airflow.
POSTGRES_PASSWORD=cambiar-password-postgres

# Clave Fernet: 32 bytes en base64 urlsafe, por ejemplo:
#   python3 -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
AIRFLOW_FERNET_KEY=cambiar-fernet-key-base64-urlsafe-32-bytes=

# Secreto JWT de la API de Airflow 3 (debe ser igual para api-server, scheduler, etc.).
AIRFLOW_JWT_SECRET=cambiar-jwt-secret

# Límites de memoria por servicio (valores por defecto para 8 GB; bajar en instancias de 4 GB).
MEM_POSTGRES=512m
MEM_INIT=1g
MEM_API_SERVER=1g
MEM_SCHEDULER=1536m
MEM_DAG_PROCESSOR=768m
MEM_TRIGGERER=512m

# Prefijo de recursos (variable de Airflow `prefix`; jobs Glue ${prefix}-small|medium|large).
AIRFLOW_PREFIX=bigdata
